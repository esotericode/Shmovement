; Shmovement — original movement study
config_version=5

[application]
config/name="Shmovement"
run/main_scene="res://scenes/playground.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[physics]
common/physics_ticks_per_second=30
common/physics_interpolation=true
3d/physics_engine="GodotPhysics3D"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1

[input]

attack={
"deadzone": 0.18,
"events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventJoypadButton,"button_index":2)]
}

move_left={
"deadzone": 0.18,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]
}

move_right={
"deadzone": 0.18,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
}

move_forward={
"deadzone": 0.18,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]
}

move_back={
"deadzone": 0.18,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]
}

jump={
"deadzone": 0.18,
"events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventJoypadButton,"button_index":0)]
}

crouch={
"deadzone": 0.18,
"events": [Object(InputEventKey,"physical_keycode":4194325), Object(InputEventJoypadMotion,"axis":4,"axis_value":1.0), Object(InputEventJoypadButton,"button_index":9)]
}

look_left={
"deadzone": 0.18,
"events": [Object(InputEventKey,"physical_keycode":74), Object(InputEventJoypadMotion,"axis":2,"axis_value":-1.0)]
}

look_right={
"deadzone": 0.18,
"events": [Object(InputEventKey,"physical_keycode":76), Object(InputEventJoypadMotion,"axis":2,"axis_value":1.0)]
}

look_up={
"deadzone": 0.18,
"events": [Object(InputEventKey,"physical_keycode":73), Object(InputEventJoypadMotion,"axis":3,"axis_value":-1.0)]
}

look_down={
"deadzone": 0.18,
"events": [Object(InputEventKey,"physical_keycode":75), Object(InputEventJoypadMotion,"axis":3,"axis_value":1.0)]
}

reset={
"deadzone": 0.18,
"events": [Object(InputEventKey,"physical_keycode":82), Object(InputEventJoypadButton,"button_index":3)]
}

recenter={
"deadzone": 0.18,
"events": [Object(InputEventKey,"physical_keycode":70), Object(InputEventJoypadButton,"button_index":7)]
}

toggle_assists={
"deadzone": 0.18,
"events": [Object(InputEventKey,"physical_keycode":4194332)]
}

tuning={
"deadzone": 0.18,
"events": [Object(InputEventKey,"physical_keycode":84), Object(InputEventJoypadButton,"button_index":6)]
}
